# Auto-generated by pyscripts/site_generator/generate_site.py, and regenerated by
# .github/workflows/deploy.yml before publishing — so a content change shows up as
# a diff of the data it came from, not of the 700 files derived from it.
#
# Adding a language to jsondata/languages.json adds a mirror directory here too.

# Per-language mirrors of the whole site
/el/
/grc/
/cyp/

# Taxonomy, locality and journal pages
/tree/
/localities/
/journal/*.html
/journal/cyp-narration.json

# Root pages
/index.html
/index.json
/map.html
/map.json
/gallery.html
/gallery-*.html
/quiz.html
/quiz.json
/cookies.html
/cookies.json
/acknowledgements.html
/acknowledgements.json
/unclassified.html
/unclassified.json
/sitemap.xml
/404.html
/404.json

# Cypriot narration, synthesized by CI (see CONTRIBUTING.md)
/audio/cyp/

# Chrome fallbacks, the sample list, the taxon name and icon lookups
/templates/header.html
/templates/footer.html
/scripts/random-sample.js
/jsondata/pages.json
/jsondata/taxa_names.json
/jsondata/taxa_icons.json

