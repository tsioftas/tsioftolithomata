{
  // A dev container so that looking at a branch takes no typing.
  //
  // The point is previewing a pull request from a phone: open the codespace link
  // in the PR comment (see .github/workflows/pr-preview.yml), wait, and the site
  // is already being served on a public URL in the Ports tab. That is a real
  // deployment of the branch — its own images, its own data, nothing copied and
  // nothing committed anywhere.
  //
  // Nothing is installed and nothing is built. The generator's output is
  // committed, so a checkout is already a complete site, and serving it needs
  // only python3's standard library. Every optional step is a step that can fail
  // during startup and leave a phone with no site and no way to read the log.
  //
  // To work on the generator in here instead of just looking at the site:
  //   pip install -r pyscripts/requirements.txt
  //   python -m pyscripts.site_generator.generate_site
  "name": "apolithomata.com",

  // A Python image, not devcontainers/universal. universal carries .NET, Java,
  // Ruby, conda and Node — tens of gigabytes unpacked — and this repository is a
  // 3.2 GB clone. Together they do not fit the 32 GB disk of a default codespace,
  // and the container creation fails partway through with "no space left on
  // device", which surfaces only as "a configuration error" and drops the
  // codespace into recovery mode. Serving this site needs python3 and nothing
  // else; the generator needs pip and the three packages in
  // pyscripts/requirements.txt.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // For `gh codespace ports visibility` in serve.sh. Small, unlike the image
  // that used to provide it.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Every start, including resuming a stopped codespace, so the site is up
  // without anyone attaching a terminal to it.
  //
  // Backgrounded on purpose: a lifecycle command that does not exit holds up the
  // rest of the start sequence. setsid puts the server in its own session so it
  // is not taken down with the shell that launched it, and the trailing `true`
  // means a failure here costs the preview rather than the whole codespace.
  "postStartCommand": "setsid nohup bash .devcontainer/serve.sh > /tmp/serve-boot.log 2>&1 < /dev/null & true",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "apolithomata.com",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        // Two prompts stand between opening this codespace and seeing the site,
        // and both are asking about content the reader already chose to open:
        // the workspace-trust dialog, and the one guarding the folderOpen task
        // that starts the server. Answering them is the difference between a
        // preview link and a preview link plus homework, so they are answered
        // here. This applies inside the container only — it does not change how
        // anyone's own editor treats this repository.
        "security.workspace.trust.enabled": false,
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
