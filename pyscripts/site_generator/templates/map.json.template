{
    {# One object per supported language (jsondata/languages.json); marker shown for
       partial langs. These strings are page-only, kept out of jsondata/dict.json
       because every page on the site downloads that and only this page asks for them.
       updatePageKeys() (scripts/language.js) reads the page dict first and falls back
       to dict.json, and prefill_translations() does the same at build time; the taxon
       search placeholder is resolved from globalDict by explore.js at runtime, which
       language.js folds a page dict's strings into. #}
    {% set static = {
        "τίτλος": {
            "el": "Εξερεύνηση της συλλογής",
            "en": "Explore the collection",
            "grc": "Ἐξερεύνησις τῆς συλλογῆς"
        },
        "filter-country-label": {
            "el": "Χώρα",
            "en": "Country",
            "grc": "Χώρα",
            "cyp": "Χώρα"
        },
        "filter-taxon-label": {
            "el": "Κλάδος",
            "en": "Clade",
            "grc": "Κλάδος",
            "cyp": "Κλάδος"
        },
        "filter-search-placeholder": {
            "el": "Αναζήτηση κλάδου...",
            "en": "Search a clade...",
            "grc": "Ζητεῖν κλάδον...",
            "cyp": "Γύρεψε κλάδον..."
        },
        "filter-clear-all": {
            "el": "Καθαρισμός",
            "en": "Clear",
            "grc": "Καθαρίσαι",
            "cyp": "Φτζ̌αίρομαν"
        }
    } -%}
    {% for lang, lcfg in languages.items() %}{% if not loop.first %},{% endif %}
    "{{lang}}": {
        {% for key, vals in static.items() -%}
        "{{key}}": "{{vals[lang] if vals[lang] is defined else lcfg.marker}}"{{ "," if not loop.last }}
        {% endfor %}
    }
    {% endfor %}
}
