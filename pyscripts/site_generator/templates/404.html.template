<!DOCTYPE html>
<html lang="{{page_lang}}" data-prerendered-lang="{{page_lang}}" data-default-lang="{{default_lang}}"
      data-site-root="{{root_relative_prefix}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="No page lives at this address.">
    <!-- A 404 is served in place of whatever was asked for, so it must not be indexed
         under the address that failed. -->
    <meta name="robots" content="noindex, follow">
    <title id="notfound-title"></title>
    <link rel="icon" href="{{root_relative_prefix}}favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="{{root_relative_prefix}}style.css">
    {% include "head_lang.html" %}
</head>
<body>
    {% include "header.html" %}

    <div class="main-section-wrapper">
        <main>
            <section class="notfound-page">
                <!-- The missing page drawn as what it would be in rock: an
                     unconformity. Younger beds above, the erosional surface, then the
                     interval that was never deposited or was cut away again, then the
                     older beds that survived. The status code sits in the gap. -->
                <svg class="notfound-unconformity" viewBox="0 0 320 140" aria-hidden="true" focusable="false">
                    <g class="strata">
                        <path d="M0 10 H320"/>
                        <path d="M0 23 H320"/>
                        <path d="M0 36 H320"/>
                    </g>
                    <path class="erosion-surface" d="M0 52 C 44 41, 78 62, 118 50 S 198 36, 238 53 S 294 63, 320 48"/>
                    <text class="notfound-code" x="160" y="107">404</text>
                    <g class="strata">
                        <path d="M0 124 H320"/>
                        <path d="M0 136 H320"/>
                    </g>
                </svg>
                <h1 id="notfound-heading"></h1>
                <p id="notfound-message"></p>
                <p><a class="notfound-home" id="notfound-home" href="{{page_prefix}}"></a></p>
            </section>
        </main>
    </div>

    <div id="footer-container">{% include "footer.html" %}</div>

</body>

<script
    id="language-script"
    src="{{root_relative_prefix}}scripts/language.js"
    dict="/404.json"
    keys="notfound-title,notfound-heading,notfound-message,notfound-home"
    galleryLength="0"
></script>

<script src="{{root_relative_prefix}}scripts/sidebar.js"></script>
<script src="{{root_relative_prefix}}scripts/search.js"></script>
<script src="{{root_relative_prefix}}scripts/analytics.js"></script>
<script src="{{root_relative_prefix}}scripts/footer.js"></script>
<script src="{{root_relative_prefix}}scripts/share.js"></script>
<script src="{{root_relative_prefix}}scripts/header.js" id="header-script"></script>

</html>
