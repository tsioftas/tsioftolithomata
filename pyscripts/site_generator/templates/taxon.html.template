{%- from "icons.html" import icon -%}
<!DOCTYPE html>
<html lang="{{page_lang}}" data-prerendered-lang="{{page_lang}}" data-default-lang="{{default_lang}}"
      data-site-root="{{root_relative_prefix or './'}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="{{meta_description}}">
    {% if meta_keywords -%}
    <meta name="keywords" content="{{meta_keywords}}">
    {% endif -%}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{name_en.capitalize()}}">
    <meta property="og:description" content="{{meta_description}}">
    <meta property="og:url" content="{{page_url}}">
    <meta property="og:image" content="{{og_image}}">
    <meta name="twitter:card" content="summary_large_image">
    <title id="τίτλος"></title>
    <link rel="icon" href="{{root_relative_prefix}}favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="{{root_relative_prefix}}style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lightgallery.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lg-zoom.min.css">
    {% include "head_lang.html" %}
</head>
<body class="taxon-page">
    {% include "header.html" %}

    <main id="main">
        {#- The exhibit's label: the name set as large as the screen allows, the
            counts in the data voice, and the illustration on its parchment plate. -#}
        <section class="specimen-head taxon-hero" id="{{taxon_id}}-hero">
            <div class="head-text">
                <p class="head-facts enter" style="--i:0">
                    {%- if n_specimens %}
                    <a href="#{{taxon_id}}-gallery"><b>{{n_specimens}}</b> {{chrome.count_specimen if n_specimens == 1 else chrome.count_specimens}}</a>
                    <a href="#{{taxon_id}}-gallery"><b>{{n_localities}}</b> {{chrome.count_locality if n_localities == 1 else chrome.count_localities}}</a>
                    {%- endif %}
                    {%- if subtaxa %}
                    <a href="#{{taxon_id}}-sub"><b>{{subtaxa|length}}</b> {{ ui_string('υποομάδες', page_lang) }}</a>
                    {%- endif %}
                </p>
                <h1 id="{{taxon_id}}" class="mega head-name enter" style="--i:1"></h1>
            </div>
            <figure class="head-plate enter" style="--i:2">
                <picture class="story-illustration">
                    <source srcset="{{root_relative_prefix}}images/thumbnails/webp_dir/{{name_el.capitalize() | urlencode}}.webp 1x" type="image/webp">
                    <img src="{{root_relative_prefix}}images/thumbnails/{{name_el.capitalize()}}.jpg" alt="{{name_en}}" class="tax-page-image" id="{{taxon_id}}-περιγραφή-1-εικόνα" fetchpriority="high">
                </picture>
                {% if taxon_icon -%}
                <span class="story-phylopic"><img src="{{ taxon_icon }}" alt="" loading="lazy"></span>
                {% endif -%}
            </figure>
        </section>

        {% include "time_strip.html" %}

        <section class="taxon-body{% if not subtaxa %} no-sub{% endif %}">
            <div class="taxon-story" id="{{taxon_id}}-story">
                <div class="description-text">
                    {% for i in range(description_paragraphs) %}<p id="{{taxon_id}}-περιγραφή-{{i+1}}"></p>
                    {% endfor %}
                </div>
                {% if etymology_paragraphs > 0 -%}
                <aside class="story-aside">
                    <h2 class="eyebrow" id="ετυμολογία"></h2>
                    <div class="etymology-text">
                        {% for i in range(etymology_paragraphs) %}<p id="{{taxon_id}}-ετυμολογία-{{i+1}}"></p>
                        {% endfor %}
                    </div>
                </aside>
                {% endif -%}
            </div>

            {% if subtaxa -%}
            <nav class="taxon-sub" id="{{taxon_id}}-sub">
                <h2 class="eyebrow" id="υποομάδες"></h2>
                <ol class="sub-list">
                    {% for subtaxon_id, subtaxon_dict in subtaxa.items() -%}
                    {% set smeta = subtaxa_meta.get(subtaxon_id, {}) -%}
                    <li>
                        <a class="sub-row{% if smeta.extinct %} is-extinct{% endif %}" href="{{subtaxon_id}}/{{subtaxon_id}}">
                            <i class="sub-index">{{ '%02d' % loop.index }}</i>
                            <picture class="sub-art">
                                <source srcset="{{root_relative_prefix}}images/thumbnails/thumbs_dir/{{subtaxon_dict.name.el.capitalize() | urlencode}}_thumb.webp 1x" type="image/webp">
                                <img loading="lazy" src="{{root_relative_prefix}}images/thumbnails/thumbs_dir/{{subtaxon_dict.name.el.capitalize()}}_thumb.jpg" alt="" class="tax-thumbnail-image">
                            </picture>
                            <h3 class="sub-name" id="{{taxon_id}}-{{subtaxon_id}}"></h3>
                            {#- The rank word is deliberately not shown: ranks are not
                                consistently defined across the groups here. -#}
                            <span class="sub-count">{% if smeta.sample_count > 0 %}{{smeta.sample_count}}{% endif %}</span>
                            {{ icon("arrow", "icon sub-arrow") }}
                        </a>
                    </li>
                    {% endfor -%}
                </ol>
            </nav>
            {%- endif %}
        </section>

        {% set galleryns=namespace(img_counter=0, gallery_counter=0) -%}
        {% if samples_by_locality -%}
        <section class="taxon-fossils" id="{{taxon_id}}-gallery">
            {% for locality, samples in samples_by_locality.items() %}
            {% set lmeta = locality_meta.get(locality, {}) -%}
            <div class="locality-block" id="loc-{{locality}}" data-locality="{{locality}}"{% if lmeta.period_color %} style="--loc: {{lmeta.period_color}}"{% endif %}>
                <header class="group-head">
                    <div class="age-rail{% if not lmeta.has_age %} age-rail-bare{% endif %}">
                        {% if lmeta.has_age -%}
                        <span class="age-figure" id="loc-{{locality}}-age-figure"></span>
                        <span class="age-unit" id="loc-{{locality}}-age-unit"></span>
                        <span class="age-interval" id="loc-{{locality}}-age-interval"></span>
                        {% endif -%}
                    </div>
                    <div class="group-title">
                        <p class="locality-meta">
                            {%- if lmeta.flag_emoji %}<span class="locality-flag" title="{{lmeta.country|upper}}">{{lmeta.flag_emoji}}</span>{% endif %}
                            {%- if lmeta.has_formation %}<span class="locality-formation" id="loc-{{locality}}-formation"></span>{% endif %}
                        </p>
                        <a class="locality-name-link" href="{{page_prefix}}localities/{{locality}}"><h2 class="locality-name" id="loc-{{locality}}-name"></h2></a>
                    </div>
                    <span class="locality-count">{{samples|length}} {{chrome.count_specimen if samples|length == 1 else chrome.count_specimens}}</span>
                </header>
                <div class="gallery" id="gallery-{{locality}}">
                    {% for sample in samples %}
                    {% set galleryns.gallery_counter = galleryns.gallery_counter + 1 %}
                    {# Only the photographs that caught a fossil this page is about. #}
                    {% set preview_images = images_showing(sample.preview_images, sample.taxa_under(taxon_id)) %}
                    <div class="sample-box" id="sample-{{ sample.sample_id }}" onclick="openGallery({{ galleryns.gallery_counter }})" style="--n:{{ loop.index0 }}">
                        {% include "specimen_plate.html" %}

                        {% if sample.acquisition == 'purchased' %}
                        {% set purchased = ui_string('acquisition-purchased', page_lang) %}
                        <span class="purchased-badge">
                            <svg class="purchased-badge-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12 12 2h8v8L10 20z"/><circle cx="16.5" cy="7.5" r="1.5"/></svg>
                            <span class="purchased-badge-label">{{ purchased }}</span>
                        </span>
                        {% endif %}

                        <!-- Hidden gallery -->
                        <div id="hidden-gallery-{{ galleryns.gallery_counter }}" data-sample-id="{{ sample.sample_id }}" style="display: none;">
                            {% for img in images_showing(sample.display_images, sample.taxa_under(taxon_id)) %}
                            {% set galleryns.img_counter = galleryns.img_counter + 1 %}
                            <a href="{{root_relative_prefix}}{{img.images_dir}}/{{img.filename}}.jpg" id="gallery-img-{{galleryns.img_counter}}" data-sub-html="{{ lightbox_caption(img, sample, page_lang, galleryns.gallery_counter, none) }}">
                                <picture>
                                    <source srcset="{{root_relative_prefix}}{{img.images_dir}}/thumbs_dir/{{img.filename}}_thumb.webp 1x" type="image/webp">
                                    <img loading="lazy" src="{{root_relative_prefix}}{{img.images_dir}}/thumbs_dir/{{img.filename}}_thumb.jpg" alt="{{img.caption.en}}">
                                </picture>
                            </a>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </section>
        {% endif -%}
    </main>

    <div id="footer-container">{% include "footer.html" %}</div>

    <script
        id="language-script"
        src="{{root_relative_prefix}}scripts/language.js"
        {# Nothing to fetch: the strings are prefilled and the captions are in
           data-sub-html. The .json is still written, for the cyp audio pipeline. #}
        dict=""
        keys="τίτλος,{{taxon_id}}{% for i in range(description_paragraphs) %},{{taxon_id}}-περιγραφή-{{i+1}}{% endfor %}{% if etymology_paragraphs > 0 %},ετυμολογία{% for i in range(etymology_paragraphs) %},{{taxon_id}}-ετυμολογία-{{i+1}}{% endfor %}{% endif %}{% if samples_by_locality %}{% for locality in samples_by_locality.keys() %},loc-{{locality}}-name{% if locality_meta.get(locality, {}).get('has_age') %},loc-{{locality}}-age-interval,loc-{{locality}}-age-figure,loc-{{locality}}-age-unit{% endif %}{% if locality_meta.get(locality, {}).get('has_formation') %},loc-{{locality}}-formation{% endif %}{% endfor %}{% endif %}{% if subtaxa %},υποομάδες{% for subtaxon_id in subtaxa.keys() %},{{taxon_id}}-{{subtaxon_id}}{% endfor %}{% endif %}"
    ></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/lightgallery.min.js" integrity="sha384-MjUNxSaHL/6eoaiJXs3NcsYt5PMcFos3RjoGKaBj8wqEu0lYAn0HISvhdiF8fjec" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/plugins/zoom/lg-zoom.min.js" integrity="sha384-iqgECBkmcDeuB5f3eHKQ6uwRVFs6/4auvPpRhMS/KjpIuzgmo2W17KoMh8iGyAHy" crossorigin="anonymous"></script>
    <script src="{{root_relative_prefix}}scripts/back-close.js"></script>
    <script>
        function openGallery(index, imgIndex) {
            const elem = document.getElementById("hidden-gallery-" + index);
            // Build the lightGallery instance once per specimen and reuse it on
            // subsequent opens, so closed lightboxes don't pile up in the DOM.
            if (!elem._lgInstance) {
                const items = Array.from(elem.querySelectorAll('a')).map(a => ({
                    src: a.href,
                    thumb: a.querySelector('img')?.src,
                    subHtml: a.getAttribute('data-sub-html') || '@@@@'
                }));
                elem._lgInstance = lightGallery(elem, {
                    dynamic: true,
                    plugins: [lgZoom],
                    thumbnail: true,
                    loop: true,
                    dynamicEl: items
                });
                closeLightGalleryOnBack(elem, elem._lgInstance);
                attachLightboxShare(elem, elem.dataset.sampleId);
            }
            elem._lgInstance.openGallery(imgIndex || 0);
        }
    </script>

    <script src="{{root_relative_prefix}}scripts/sidebar.js"></script>
    <script src="{{root_relative_prefix}}scripts/search.js"></script>
    <script src="{{root_relative_prefix}}scripts/analytics.js"></script>
    <script src="{{root_relative_prefix}}scripts/footer.js"></script>
    <script src="{{root_relative_prefix}}scripts/share.js"></script>
    <script src="{{root_relative_prefix}}scripts/tts.js"></script>
    <script src="{{root_relative_prefix}}scripts/header.js" id="header-script"></script>
    <script src="{{root_relative_prefix}}scripts/ui.js"></script>

    {% include "cookie_banner.html" %}
</body>
</html>
