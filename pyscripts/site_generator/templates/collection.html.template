{%- macro icon(name) -%}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "close" -%}<path d="M6 6l12 12M18 6 6 18"/>
{%- elif name == "arrow" -%}<path d="M4.5 12h15M13.5 6l6 6-6 6"/>
{%- elif name == "arrow-left" -%}<path d="M19.5 12h-15M10.5 6l-6 6 6 6"/>
{%- elif name == "shuffle" -%}<path d="M3.5 7h3.2c2 0 3.2 1 4.3 2.7l2 3.6c1 1.7 2.3 2.7 4.3 2.7h3.2"/><path d="M3.5 17h3.2c1.4 0 2.4-.5 3.3-1.4M13.9 8.4c.9-.9 1.9-1.4 3.3-1.4h3.3"/><path d="m18 4.5 2.5 2.5L18 9.5M18 14.5l2.5 2.5-2.5 2.5"/>
{%- elif name == "filter" -%}<path d="M4 6h16M7 12h10M10 18h4"/>
{%- elif name == "reset" -%}<path d="M4.6 12a7.4 7.4 0 1 0 2.2-5.3"/><path d="M4.2 4.4v4.2h4.2"/>
{%- endif -%}
</svg>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="{{page_lang}}" data-prerendered-lang="{{page_lang}}" data-default-lang="{{default_lang}}"
      data-site-root="{{root_relative_prefix or './'}}">
<head>
    <meta charset="UTF-8">
    <title id="τίτλος"></title>
    <meta name="description" content="Every fossil in the collection on one canvas: by taxonomy, from the kingdoms down to each specimen, or by geological time.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <link rel="icon" href="{{root_relative_prefix}}favicon.ico" type="image/x-icon">
    <link rel="preload" as="image" href="{{root_relative_prefix}}{{field_atlas}}">
    <link rel="stylesheet" href="{{root_relative_prefix}}style.css">
    <link rel="stylesheet" href="{{root_relative_prefix}}scripts/field.css?v={{asset_version('scripts/field.css')}}">
    {% include "head_lang.html" %}
</head>
<body class="field-page">
    {% include "header.html" %}

    <main id="main">
        <!-- Every specimen as a tile. The tiles are links to each specimen's page, so
             the page is a complete index without script; scripts/field.js arranges
             them by taxonomy or by time. -->
        <section id="field" class="field" data-mode="tree"
                 data-atlas="{{root_relative_prefix}}{{field_atlas}}" style="--cols: {{field_cols}}; --rows: {{field_rows}};">
            <h1 class="visually-hidden" id="collection-title"></h1>

            <div class="field-world">
                <div class="field-back"></div>
                <div class="field-tiles">
                    {%- for tile in field_tiles %}
                    <a class="tile{% if tile.n %} is-new{% endif %}" href="{{page_prefix}}{{tile.h}}" aria-label="{{tile.label[page_lang]}}" style="--c:{{tile.c}};--col:{{tile.col}};--row:{{tile.row}}"></a>
                    {%- endfor %}
                </div>
                <div class="field-labels"></div>
            </div>

            <div class="field-ui">
                <!-- How the view is arranged, then the camera. -->
                <div class="field-modes">
                    <div class="field-mode-group" role="group">
                        <button type="button" data-field-mode="tree" aria-pressed="true"><span id="field-tree"></span></button>
                        <button type="button" data-field-mode="time" aria-pressed="false"><span id="field-time"></span></button>
                    </div>
                    <div class="field-zoom" role="group">
                        <button type="button" class="field-zoom-step" data-field-zoom="out" aria-label="−"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
                        <button type="button" class="field-reset" data-field-zoom="fit">{{ icon("reset") }}<span id="field-reset"></span></button>
                        <button type="button" class="field-zoom-step" data-field-zoom="in" aria-label="+"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg></button>
                    </div>
                </div>
                <!-- Where in the taxonomy the view is; filled by scripts/field.js. -->
                <nav class="field-path" id="field-path" aria-label="{{chrome.tree_of_life}}"></nav>
                <!-- Ways of drawing the taxonomy; scripts/field.js keeps the choice in the address. -->
                <div class="field-styles" role="group" aria-labelledby="field-tree">
                    <button type="button" data-tree-style="branches" aria-pressed="true"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4" r="1.6"/><path d="M12 5.6V9M5 9h14M5 9v4M12 9v4M19 9v4"/><rect x="3.5" y="15" width="3" height="5" rx=".6"/><rect x="10.5" y="15" width="3" height="5" rx=".6"/><rect x="17.5" y="15" width="3" height="5" rx=".6"/></svg><span id="style-branches"></span></button>
                    <button type="button" data-tree-style="radial" aria-pressed="false"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1.6"/><path d="M12 10.4V6M13.4 12.8l3.8 2.2M10.6 12.8l-3.8 2.2"/><circle cx="12" cy="12" r="8.5" stroke-dasharray="2 2.6"/></svg><span id="style-radial"></span></button>
                    <button type="button" data-tree-style="bubbles" aria-pressed="false"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="3.6"/><circle cx="15.6" cy="14.6" r="2.6"/><circle cx="14.6" cy="7.6" r="1.4"/></svg><span id="style-bubbles"></span></button>
                    <button type="button" data-tree-style="boxes" aria-pressed="false"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 8h18M12 8v13M12 14.5h9"/></svg><span id="style-boxes"></span></button>
                    <button type="button" data-tree-style="outline" aria-pressed="false"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="5" r="1.3"/><path d="M8.5 5H20M7 7v10.5M7 12h3M7 17.5h3M12.5 12H20M12.5 17.5H20"/></svg><span id="style-outline"></span></button>
                </div>

                <div class="field-tools">
                    <!-- Narrowing the collection by name, place and age; scripts/field.js. -->
                    <div class="field-filter" id="field-filter">
                        <div class="field-filter-panel" id="field-filter-panel" hidden>
                            <input type="search" class="field-filter-q" id="field-filter-q" autocomplete="off" spellcheck="false">
                            <span id="field-filter-q-label" hidden></span>
                            <div class="field-chips field-suggest" data-filter="suggest"></div>
                            <p class="field-filter-heading" id="field-filter-taxon"></p>
                            <div class="field-chips" data-filter="taxa"></div>
                            <p class="field-filter-heading" id="field-filter-place"></p>
                            <div class="field-chips" data-filter="places"></div>
                            <p class="field-filter-heading" id="field-filter-age"></p>
                            <div class="field-chips" data-filter="ages"></div>
                            <button type="button" class="field-filter-clear" id="field-filter-clear"></button>
                        </div>
                        <button type="button" class="field-filter-toggle" aria-expanded="false" aria-controls="field-filter-panel">{{ icon("filter") }}<span id="field-filter-label"></span><b class="field-filter-count"></b></button>
                    </div>
                    <button type="button" class="field-random" data-field-random>{{ icon("shuffle") }}<span id="field-random"></span></button>
                </div>

                <div class="field-empty">
                    <p id="field-empty-text"></p>
                    <button type="button" class="field-empty-clear" id="field-empty-clear"></button>
                </div>
            </div>

            <div id="field-tip" class="field-tip" hidden><span class="tip-taxon"></span><span class="tip-meta"></span></div>
        </section>

        <!-- A specimen, opened from the canvas. -->
        <aside id="field-sheet" class="sheet" hidden>
            <figure class="sheet-media">
                <img class="sheet-photo" alt="">
                <button type="button" class="sheet-prev-photo">{{ icon("arrow-left") }}</button>
                <button type="button" class="sheet-next-photo">{{ icon("arrow") }}</button>
                <span class="sheet-count"></span>
                <figcaption class="sheet-caption"></figcaption>
            </figure>
            <div class="sheet-body">
                <div class="sheet-top">
                    <span class="sheet-id"></span>
                    <span class="sheet-new" id="field-new" hidden></span>
                    <button type="button" class="sheet-close" aria-label="×">{{ icon("close") }}</button>
                </div>
                <p class="sheet-path"></p>
                <h2 class="sheet-taxa"></h2>
                <div class="sheet-when"><span class="sheet-age"></span><span class="sheet-band"></span></div>
                <a class="sheet-place"><span class="sheet-place-flag"></span><span class="sheet-place-name"></span></a>
                <div class="sheet-actions">
                    <a class="sheet-link"><span id="field-open"></span>{{ icon("arrow") }}</a>
                    <div class="sheet-nav">
                        <button type="button" class="sheet-prev">{{ icon("arrow-left") }}<span class="visually-hidden" id="field-prev"></span></button>
                        <button type="button" class="sheet-next">{{ icon("arrow") }}<span class="visually-hidden" id="field-next"></span></button>
                        <!-- Another random specimen, while one is open. -->
                        <button type="button" class="sheet-random" data-field-random>{{ icon("shuffle") }}<span class="visually-hidden" id="field-random-again"></span></button>
                    </div>
                </div>
            </div>
        </aside>
    </main>

    <!-- Cookie banner (translated by language.js) -->
    <div id="cookie-banner" style="display:none; position:fixed; bottom:0; left:0; right:0; background:#222; color:#fff; padding:1em; z-index:9999; font-size:14px; text-align:center;">
        <a id="cookie-banner-text">{{ ui_string('cookie-banner-text', page_lang) }}</a>
        <button onclick="setConsent(true)" style="margin-left:1em;" id="cookie-banner-accept">{{ ui_string('cookie-banner-accept', page_lang) }}</button>
        <button onclick="setConsent(false)" style="margin-left:0.5em;" id="cookie-banner-decline">{{ ui_string('cookie-banner-decline', page_lang) }}</button>
    </div>

    <script
        id="language-script"
        src="{{ root_relative_prefix }}scripts/language.js"
        dict="/collection.json"
        keys="τίτλος,collection-title,field-tree,field-time,style-branches,style-radial,style-bubbles,style-boxes,style-outline,field-random,field-random-again,field-filter-label,field-filter-q-label,field-filter-taxon,field-filter-place,field-filter-age,field-filter-clear,field-empty-text,field-empty-clear,field-prev,field-next,field-reset,field-open,field-new"
    ></script>

    <!-- d3-hierarchy packs the taxonomy's bubbles. -->
    <script src="https://cdn.jsdelivr.net/npm/d3-hierarchy@3.1.2/dist/d3-hierarchy.min.js" integrity="sha384-WNr9kP7FJlLJ8Cjg/MC+b23H5hRo5I5T8rbsrqZMi0Zl7bTsYgHDUoQ+qV2uLia3" crossorigin="anonymous"></script>
    <script src="{{ root_relative_prefix }}scripts/field.js?v={{asset_version('scripts/field.js')}}"></script>

    <script src="{{ root_relative_prefix }}scripts/sidebar.js"></script>
    <script src="{{ root_relative_prefix }}scripts/search.js"></script>
    <script src="{{ root_relative_prefix }}scripts/analytics.js"></script>
    <script src="{{ root_relative_prefix }}scripts/footer.js"></script>
    <script src="{{ root_relative_prefix }}scripts/share.js"></script>
    <script src="{{ root_relative_prefix }}scripts/header.js"></script>
</body>
</html>
