<!DOCTYPE html>
<html lang="{{page_lang}}" data-prerendered-lang="{{page_lang}}" data-default-lang="{{default_lang}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{meta_description}}">
  {% if meta_keywords -%}
  <meta name="keywords" content="{{meta_keywords}}">
  {% endif -%}
  <title>{{ title }}</title>
  <link rel="icon" href="{{root_relative_prefix}}favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="{{root_relative_prefix}}style.css" />
  {% include "head_lang.html" %}
</head>
<body>
  {% include "header.html" %}

  <div class="main-section-wrapper">
    <main class="journal-index">
      <h1>{{title}}</h1>

      <ul class="journal-index-list">
        {% for e in entries %}
        <li class="journal-index-item">
          <a class="journal-index-link" href="./{{ e.slug }}.html">
            {% if e.cover %}<div class="journal-index-thumb"><img src="{{ e.cover }}" alt="" loading="lazy"></div>{% endif %}
            <div class="journal-index-body">
              <div class="journal-index-title">{{ e.title }}</div>
              <div class="journal-index-meta">
                <span>{{ e.date }}</span>
                {% if e.category %}<span class="journal-entry-sep">·</span><span>{{ e.category }}</span>{% endif %}
              </div>
              {% if e.summary %}<div class="journal-index-summary">{{ e.summary }}</div>{% endif %}
            </div>
          </a>
        </li>
        {% endfor %}
      </ul>
    </main>
  </div>

  <div id="footer-container">{% include "footer.html" %}</div>

    <script
        id="language-script"
        src="{{root_relative_prefix}}scripts/language.js"
        dict="/jsondata/dict.json"
        keys=""
        galleryLength="0"
    ></script>
    <script src="{{root_relative_prefix}}scripts/sidebar.js"></script>
    <script src="{{root_relative_prefix}}scripts/search.js"></script>
    <script src="{{root_relative_prefix}}scripts/analytics.js"></script>
    <script src="{{root_relative_prefix}}scripts/footer.js"></script>
    <script src="{{root_relative_prefix}}scripts/share.js"></script>
    <script src="{{root_relative_prefix}}scripts/header.js" id="header-script"></script>

    <div id="cookie-banner" style="display:none;">
        <a id="cookie-banner-text">This site uses cookies to analyze traffic.</a>
        <button onclick="setConsent(true)" id="cookie-banner-accept">Accept</button>
        <button onclick="setConsent(false)" id="cookie-banner-decline">Decline</button>
    </div>

</body>
</html>
