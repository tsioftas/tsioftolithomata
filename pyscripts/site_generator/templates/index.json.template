            "en": "This site is a digital catalogue of my personal fossil collection, documenting specimens that I have studied and classified to the best of my knowledge. Inside you will find photographs of the specimens, information about the localities where they were found and their paleoenvironments, as well as information about the taxonomic groups to which they belong.",
            "grc": "Ὁ ἱστότοπος οὗτός ἐστι κατάλογος τῆς ἐμαυτοῦ συλλογῆς ἀπολιθωμάτων· ἐν αὐτῷ ἀναγράφω τὰ δείγματα, ἃ ἐξήτασα καὶ κατέταξα, καθ᾽ ὅσον ἐμοὶ γνῶναι δυνατὸν ἦν. Ἐνταῦθα εὑρήσετε εἰκόνας τῶν δειγμάτων· μαθήσεσθε δὲ ἔν τε ποίοις τόποις ἕκαστον εὑρέθη καὶ πῶς οἱ τόποι οὗτοι τὸ πάλαι διέκειντο, ἔτι δὲ περὶ τῶν ταξινομικῶν ὁμάδων εἰς ἃς ἕκαστον αὐτῶν κατατέτακται.",
            "cyp": "Τούτη η ιστοσελίδα εν ένας ψηφιακός κατάλογος της συλλογής των απολιθωμάτων μου, που καταγράφει δείγματα που εμελέτησα τζ̌αι εταξινόμησα όσον πιο καλά ημπόρησα. Μέσα εννά εύρετε φωτογραφίες των δειγμάτων, πληροφορίες για τες τοποθεσίες που ευρεθήκασιν τζ̌αι για τα παλαιοπεριβάλλοντά τους, αλλά τζ̌αι πληροφορίες για τες ταξινομικές ομάδες στες οποίες ανήκουν."
        },
        "απολιθώματα-κεφαλίδα": {"el": "Ξεκινήστε την περιήγηση εδώ", "en": "Start browsing here", "grc": "Ἄρξατε ζητεῖν ὰφ' ὧδε", "cyp": "Θκιανεύτου δαχαμαί"},
        "τυχαίο-δείγμα": {"el": "Τυχαίο δείγμα: ", "en": "Random sample: ", "grc": "Τυχαῖον δεῖγμα: ", "cyp": "Τυχαίον δείγμαν: "},
        "πρόσφατες-ενημερώσεις-κεφαλίδα": {"el": "Πρόσφατες ενημερώσεις", "en": "Recently updated", "grc": "Νεώταται ἐνημερώσεις", "cyp": "Πρόσφατες ενημερώσεις"},
        "πρόσφατες-προσθήκες-κεφαλίδα": {"el": "Πρόσφατες προσθήκες", "en": "Recently catalogued", "grc": "Νεώτατα προστεθέντα", "cyp": "Πρόσφατες προσθήκες"},
        "callout-collection-title": {"el": "Εξερευνήστε τη συλλογή", "en": "Explore the collection", "grc": "Τὴν συλλογὴν ἐρεύνα", "cyp": "Εξερεύνα τη συλλογήν"},
        "callout-collection-body": {"el": "Περιηγηθείτε σε όλα τα απολιθώματα κατά ταξινομία ή γεωλογικό χρόνο. Επιλέξτε ένα δείγμα για να δείτε τις φωτογραφίες, την ηλικία και την τοποθεσία του.", "en": "Browse every fossil by taxonomy or geological time. Select a specimen to see its photographs, age and locality.", "grc": "Ἅπαντα τὰ ἀπολιθώματα κατὰ ταξινομίαν ἢ γεωλογικὸν χρόνον ἐρεύνα. Ἐπίλεξον δεῖγμα ἵνα τὰς εἰκόνας, τὴν ἡλικίαν καὶ τὸν τόπον αὐτοῦ ἴδῃς.", "cyp": "Θκιανεύτου ούλλα τα απολιθώματα κατά ταξινομίαν ή γεωλογικόν χρόνον. Δκιάλεξε έναν δείγμα για να δεις τες φωτογραφίες, την ηλικίαν τζ̌αι την τοποθεσίαν του."},
        "callout-collection-cta": {"el": "Εξερεύνηση συλλογής", "en": "Open explorer", "grc": "Ἐρεύνα τὴν συλλογήν", "cyp": "Άννοιξε τη συλλογήν"},
        "callout-gallery-title": {"el": "Επισκεφθείτε την έκθεση", "en": "Visit the gallery", "grc": "Την ἔκθεσιν ἐπισκοπεῖσθαι", "cyp": "Πάαιννε στην έκθεσην"},
        "callout-gallery-body": {"el": "Δείτε όλα τα απολιθώματα της συλλογής σε μια όμορφη συλλογή φωτογραφιών.", "en": "View all fossils from the collection in a beautiful photo gallery.", "grc": "Ἴδε πάντα τὰ ἀπολιθώματα ἐν τῇ συλλογῇ ἐν καλῇ φωτογραφίων συλλογῇ.", "cyp": "Άδε ούλλα τα απολιθώματα της συλλογής σε μιαν όμορφην συλλογήν φωτογραφιών."},
        "callout-gallery-cta": {"el": "Επίσκεψη Έκθεσης", "en": "View Gallery", "grc": "Ἴδε τὴν Ἔκθεσιν", "cyp": "Άννοιξε την έκθεσην"},
        "callout-journal-title": {"el": "Διαβάστε το ημερολόγιο", "en": "Read the journal", "grc": "Τὸ ἡμερολόγιον ἀναγιγνώσκειν", "cyp": "Θκιάβασ' το δευτέριν"},
        "callout-journal-body": {"el": "Σημειώσεις, σκέψεις και εμπειρίες γύρω από τα απολιθώματα και τη συλλογή.", "en": "Notes, thoughts and experiences about the fossils and the collection.", "grc": "Ὑπομνήματα, ἐνθυμήσεις καὶ ὅσα ἐκ πείρας ἔγνων περὶ τῶν ἀπολιθωμάτων καὶ τῆς συλλογῆς.", "cyp": "Σημειώσεις, δκιαλοϊσμοί τζ̌αι εμπειρίες για τ' απολιθώματα τζ̌αι την συλλογήν."},
        "callout-journal-cta": {"el": "Άνοιγμα Ημερολογίου", "en": "Open Journal", "grc": "Ἀνοῖξαι τὸ Ἡμερολόγιον", "cyp": "Άννοιξε το Δευτέριν"},
        "stat-localities-label": {"el": "τοποθεσίες", "en": "localities", "grc": "τοποθεσίαι", "cyp": "τόποι"},
        "stat-taxa-label": {"el": "κλάδοι", "en": "taxa", "grc": "κλάδοι", "cyp": "κλάδοι"},
        "stat-samples-label": {"el": "δείγματα", "en": "specimens", "grc": "δείγματα", "cyp": "δείγματα"},
        "stat-countries-label": {"el": "χώρες", "en": "countries", "grc": "χῶραι", "cyp": "χώρες"},
        "stat-visitors-label": {"el": "επισκέπτες", "en": "visitors", "grc": "ἐπισκέπται", "cyp": "επισκέπτες"},
        "collection-close": {"el": "Κλείσιμο", "en": "Close", "grc": "Κλεῖσαι", "cyp": ""},
        "collection-end-title": {"el": "Αυτή ήταν όλη η συλλογή", "en": "That was the whole collection", "grc": "Τοῦτο ἦν ἅπασα ἡ συλλογή", "cyp": ""},
        "collection-end-explore": {"el": "Εξερευνήστε τη συλλογή", "en": "Explore the collection", "grc": "Τὴν συλλογὴν ἐξερευνᾶν", "cyp": ""},
        "collection-end-gallery": {"el": "Επίσκεψη Έκθεσης", "en": "View Gallery", "grc": "Τὴν Ἔκθεσιν ἰδεῖν", "cyp": ""},
        "collection-end-map": {"el": "Εξερεύνηση Χάρτη", "en": "Explore the Map", "grc": "Τὸν Χάρτην ἐρευνᾶν", "cyp": ""},
        "collection-card-specimen": {"el": "Προβολή δείγματος", "en": "View specimen", "grc": "Τὸ δεῖγμα ἰδεῖν", "cyp": ""},
        "αταξινόμητα": {"el": "Αταξινόμητα", "en": "Unclassified", "grc": "Ἀταξινόμητα", "cyp": "Αταξινόμητα"}
    } -%}
    {% for lang, lcfg in languages.items() %}{% if not loop.first %},{% endif %}
    "{{lang}}": {
        {% for key, vals in static.items() if key != "αταξινόμητα" -%}
        "{{key}}": "{{vals[lang] or lcfg.marker}}",
        {% endfor %}
        {% for top_level_taxon, taxon_info in taxonomy.items() -%}
        "{{taxon_info["name"]["el"]}}": "{{taxon_info["name"][lang].capitalize() if taxon_info["name"][lang] else lcfg.marker}}",
        {% endfor -%}

        {% for recentlyUpdatedPage in recent_updates -%}
        "{{ recentlyUpdatedPage.id }}-recent": "{{ recentlyUpdatedPage.title[lang] if recentlyUpdatedPage.title[lang] else lcfg.marker }}",
        "{{ recentlyUpdatedPage.id }}-recent-description": "{{ recentlyUpdatedPage.description[lang] if recentlyUpdatedPage.description[lang] else lcfg.marker }}",
        {% endfor -%}

        "αταξινόμητα": "{{static["αταξινόμητα"][lang] if static["αταξινόμητα"][lang] is defined else lcfg.marker}}"
    }
    {% endfor %}
}
