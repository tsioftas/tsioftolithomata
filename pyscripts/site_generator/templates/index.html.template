{%- from "icons.html" import icon -%}
<!DOCTYPE html>
<html lang="{{page_lang}}" data-prerendered-lang="{{page_lang}}" data-default-lang="{{default_lang}}"
      data-site-root="{{root_relative_prefix or './'}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a09">
    <meta name="description" content="Browse a fossil collection and discover the world of ancient life. Explore detailed profiles of extinct species, from dinosaurs to stingrays.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Fossils — apolithomata.com">
    <meta property="og:description" content="Browse a fossil collection and discover the world of ancient life. Explore detailed profiles of extinct species, from dinosaurs to stingrays.">
    <meta property="og:url" content="{{page_url}}">
    <meta property="og:image" content="{{og_image}}">
    <meta name="twitter:card" content="summary_large_image">
    <title id="τίτλος"></title>
    <link rel="icon" href="{{root_relative_prefix}}favicon.ico" type="image/x-icon">
    <link rel="preload" as="image" href="{{root_relative_prefix}}{{field_atlas}}">
    <link rel="stylesheet" href="{{root_relative_prefix}}style.css">
    {% include "head_lang.html" %}
</head>
<body class="home">
    {% include "header.html" %}

    <main id="main">
        <!-- The field: the whole collection, one tile per specimen. The tiles are links
             to each specimen's page, so the field is a complete index without script;
             scripts/field.js arranges them by tree, time or place. -->
        <section id="field" class="field" data-mode="tree"
                 style="--atlas: url('{{root_relative_prefix}}{{field_atlas}}'); --cols: {{field_cols}}; --rows: {{field_rows}};">
            <h1 class="visually-hidden" id="hero-title"></h1>

            <div class="field-world">
                <div class="field-back"></div>
                <div class="field-tiles">
                    {%- for tile in field_tiles %}
                    <a class="tile{% if tile.n %} is-new{% endif %}" href="{{page_prefix}}{{tile.h}}" aria-label="{{tile.label[page_lang]}}" style="--c:{{tile.c}};--col:{{tile.col}};--row:{{tile.row}}"></a>
                    {%- endfor %}
                </div>
                <div class="field-labels"></div>
            </div>

            <div class="field-ui">
                <!-- The view's controls in one bar: how it is arranged, then the camera. -->
                <div class="field-modes">
                    <div class="field-mode-group" role="group">
                        <button type="button" data-field-mode="tree" aria-pressed="true"><i>01</i><span id="field-tree"></span></button>
                        <button type="button" data-field-mode="time" aria-pressed="false"><i>02</i><span id="field-time"></span></button>                    </div>
                    <div class="field-zoom" role="group">
                        <button type="button" class="field-zoom-step" data-field-zoom="out" aria-label="−"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14"/></svg></button>
                        <button type="button" class="field-reset" data-field-zoom="fit">{{ icon("reset", "icon field-reset-icon") }}<span id="field-reset"></span></button>
                        <button type="button" class="field-zoom-step" data-field-zoom="in" aria-label="+"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg></button>
                    </div>
                </div>
                <!-- Where in the tree or on the map the view is; filled by scripts/field.js. -->
                <nav class="field-path" id="field-path" aria-label="{{chrome.tree_of_life}}"></nav>

                <div class="field-intro">
                    <p id="hero-tagline"></p>
                    <p class="field-stats">
                        <button type="button" class="field-stat" data-field-mode="tree"><b>{{ n_samples }}</b> <span id="stat-samples-label"></span></button>
                        <button type="button" class="field-stat" onclick="toggleSidebar()"><b>{{ n_taxa }}</b> <span id="stat-taxa-label"></span></button>
                        <a class="field-stat" href="{{root_relative_prefix}}map"><b>{{ n_localities }}</b> <span id="stat-localities-label"></span></a>
                        <a class="field-stat" href="{{root_relative_prefix}}map"><b>{{ n_countries }}</b> <span id="stat-countries-label"></span></a>
                    </p>
                    <button type="button" class="field-about-btn" data-open-about aria-controls="about">{{ icon("sparkle") }}<span id="field-about"></span></button>
                </div>

                <div class="field-tools">
                    <button type="button" class="field-random" data-field-random>{{ icon("shuffle") }}<span id="field-random"></span></button>
                </div>
            </div>

            <div id="field-tip" class="field-tip" hidden><span class="tip-taxon"></span><span class="tip-meta"></span></div>
        </section>

        <!-- A specimen, opened from the field. -->
        <aside id="field-sheet" class="sheet" hidden>
            <figure class="sheet-media">
                <img class="sheet-photo" alt="">
                <button type="button" class="sheet-prev-photo">{{ icon("arrow-left") }}</button>
                <button type="button" class="sheet-next-photo">{{ icon("arrow") }}</button>
                <span class="sheet-count"></span>
                <!-- The photograph's own caption, on the photograph. -->
                <figcaption class="sheet-caption"></figcaption>
            </figure>
            <div class="sheet-body">
                <div class="sheet-top">
                    <span class="sheet-id"></span>
                    <span class="sheet-new" id="πρόσφατες-προσθήκες-κεφαλίδα" hidden></span>
                    <button type="button" class="sheet-close" aria-label="{{chrome.close}}">{{ icon("close") }}</button>
                </div>
                <p class="sheet-path"></p>
                <h2 class="sheet-taxa"></h2>
                <div class="sheet-when"><span class="sheet-age"></span><span class="sheet-band"></span></div>
                <a class="sheet-place"><span class="sheet-place-flag"></span><span class="sheet-place-name"></span></a>
                <div class="sheet-actions">
                    <a class="btn btn-uv sheet-open"><span id="collection-card-specimen"></span>{{ icon("arrow", "icon icon-arrow-end") }}</a>
                    <div class="sheet-nav">
                        <button type="button" class="sheet-prev">{{ icon("arrow-left") }}<span class="visually-hidden" id="field-prev"></span></button>
                        <button type="button" class="sheet-next">{{ icon("arrow") }}<span class="visually-hidden" id="field-next"></span></button>
                    </div>
                </div>
            </div>
        </aside>

        <!-- About the collection: the introduction, the kingdoms, what changed lately. -->
        <section id="about" class="about" hidden>
            <div class="about-scrim" data-close-about></div>
            <div class="about-panel">
                <button type="button" class="about-close" data-close-about aria-label="{{chrome.close}}">{{ icon("close") }}</button>
                <div class="about-lede">
                    <p id="εισαγωγή-παράγραφος"></p>
                </div>

                <div class="about-ledger">
                    <div><b>{{ n_samples }}</b><span>{{ chrome.count_specimens }}</span></div>
                    <div><b>{{ n_taxa }}</b><span class="about-taxa-label"></span></div>
                    <div><b>{{ n_localities }}</b><span>{{ chrome.count_localities }}</span></div>
                    <div id="visitor-stat" hidden><b id="visitor-count"></b><span id="stat-visitors-label"></span></div>
                </div>

                <h2 class="about-heading" id="απολιθώματα-κεφαλίδα"></h2>
                <div class="about-kingdoms">
                    {% for top_level_taxon, taxon_info in taxonomy.items() -%}
                    <a class="kingdom" href="{{page_prefix}}tree/{{top_level_taxon}}/{{top_level_taxon}}">
                        <picture>
                            <source srcset="{{root_relative_prefix}}images/thumbnails/thumbs_dir/{{taxon_info["name"]["el"].capitalize() | urlencode}}_thumb.webp 1x" type="image/webp">
                            <img src="{{root_relative_prefix}}images/thumbnails/thumbs_dir/{{taxon_info["name"]["el"].capitalize() | urlencode}}_thumb.jpg" alt="" loading="lazy">
                        </picture>
                        <span id="{{taxon_info["name"]["el"]}}"></span>
                    </a>
                    {% endfor -%}
                    <a class="kingdom" href="{{page_prefix}}unclassified">
                        <picture>
                            <source srcset="{{root_relative_prefix}}images/thumbnails/thumbs_dir/Αταξινόμητα_thumb.webp 1x" type="image/webp">
                            <img src="{{root_relative_prefix}}images/thumbnails/thumbs_dir/Αταξινόμητα_thumb.jpg" alt="" loading="lazy">
                        </picture>
                        <span id="αταξινόμητα"></span>
                    </a>
                </div>

                <h2 class="about-heading" id="πρόσφατες-ενημερώσεις-κεφαλίδα"></h2>
                <ul class="about-updates">
                    {% for recentlyUpdatedPage in recent_updates -%}
                    <li>
                        <a href="{{page_prefix}}{{ recentlyUpdatedPage.url }}">
                            <picture>
                                <source srcset="{{root_relative_prefix}}{{ recentlyUpdatedPage.thumbnail_webp }} 1x" type="image/webp">
                                <img src="{{root_relative_prefix}}{{ recentlyUpdatedPage.thumbnail_jpg }}" alt="" loading="lazy">
                            </picture>
                            <span class="about-update-text">
                                <time>{{ recentlyUpdatedPage.lastmod }}</time>
                                <b id="{{ recentlyUpdatedPage.id }}-recent"></b>
                                <span id="{{ recentlyUpdatedPage.id }}-recent-description"></span>
                            </span>
                        </a>
                    </li>
                    {% endfor -%}
                </ul>

                <div id="footer-container">{% include "footer.html" %}</div>
            </div>
        </section>
    </main>

    <script>
        fetch('https://tsioftas.goatcounter.com/counter/TOTAL.json')
            .then(r => r.json())
            .then(d => {
                if (!d || d.count == null) return;
                document.getElementById('visitor-count').textContent = d.count;
                document.getElementById('visitor-stat').hidden = false;
            })
            .catch(() => {});
    </script>

    {% include "cookie_banner.html" %}
</body>

<script
    id="language-script"
    src="{{root_relative_prefix}}scripts/language.js"
    dict="/index.json"
    keys="τίτλος,hero-title,hero-tagline,field-tree,field-time,field-random,field-about,field-prev,field-next,field-reset,εισαγωγή-παράγραφος,απολιθώματα-κεφαλίδα,πρόσφατες-ενημερώσεις-κεφαλίδα,πρόσφατες-προσθήκες-κεφαλίδα,stat-localities-label,stat-taxa-label,stat-samples-label,stat-countries-label,stat-visitors-label,collection-card-specimen,{% for top_level_taxon, taxon_info in taxonomy.items() %}{{taxon_info["name"]["el"]}},{% endfor %}{% for recentlyUpdatedPage in recent_updates %}{{ recentlyUpdatedPage.id }}-recent,{{ recentlyUpdatedPage.id }}-recent-description,{% endfor %}αταξινόμητα"
></script>

<script src="{{root_relative_prefix}}scripts/sidebar.js"></script>
<script src="{{root_relative_prefix}}scripts/search.js"></script>
<script src="{{root_relative_prefix}}scripts/analytics.js"></script>
<script src="{{root_relative_prefix}}scripts/footer.js"></script>
<script src="{{root_relative_prefix}}scripts/share.js"></script>
<script src="{{root_relative_prefix}}scripts/header.js" id="header-script"></script>
<script src="{{root_relative_prefix}}scripts/ui.js"></script>
<script src="{{root_relative_prefix}}scripts/field.js?v={{asset_version('scripts/field.js')}}"></script>

</html>
