<!DOCTYPE html>
<html lang="{{page_lang}}" data-prerendered-lang="{{page_lang}}" data-default-lang="{{default_lang}}"
      data-site-root="{{root_relative_prefix or './'}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Browse a fossil collection and discover the world of ancient life. Explore detailed profiles of extinct species, from dinosaurs to stingrays.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Fossils — apolithomata.com">
    <meta property="og:description" content="Browse a fossil collection and discover the world of ancient life. Explore detailed profiles of extinct species, from dinosaurs to stingrays.">
    <meta property="og:url" content="{{page_url}}">
    <meta property="og:image" content="{{og_image}}">
    <meta name="twitter:card" content="summary_large_image">
    <title id="τίτλος"></title>
    <link rel="icon" href="{{root_relative_prefix}}favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="{{root_relative_prefix}}style.css">
    {% include "head_lang.html" %}
</head>
<body class="home-page">
    {% include "header.html" %}

    <!-- Filled by the generator, so the band is already there at first paint;
         scripts/mosaic.js only takes over the swapping. -->
    <section id="hero">
        <div id="hero-grid" aria-hidden="true">
            {% for cell in mosaic_cells -%}
            <div class="m-cell m-t{{ cell.tint }}">{% if cell.photo %}<img src="{{root_relative_prefix}}{{ cell.photo }}" alt="" decoding="async">{% endif %}</div>
            {% endfor -%}
        </div>
        <div id="hero-plate">
            <h1 id="hero-title"></h1>
            <p id="hero-tagline"></p>
        </div>
    </section>

    <!-- The band expanded to the whole collection. scripts/collection.js fills the grid
         when a tile is clicked or the page opens on #collection. -->
    <div id="collection" hidden>
        <div id="collection-grid"></div>
        <div id="collection-end">
            <p id="collection-end-title"></p>
            <a href="{{root_relative_prefix}}gallery" id="collection-end-gallery"></a>
            <a href="{{root_relative_prefix}}map" id="collection-end-map"></a>
        </div>
        <button type="button" id="collection-close"></button>
        <!-- A photograph tile grows into this card; clicking the photo shrinks it back. -->
        <div id="collection-scrim"></div>
        <div id="collection-card" hidden>
            <div id="card-art"></div>
            <button type="button" id="card-photo"><img alt=""></button>
            <div id="card-body">
                <div id="card-when">
                    <div>
                        <p id="card-age-num"></p>
                        <p id="card-age-label"></p>
                    </div>
                    <img id="card-icon" alt="">
                </div>
                <p id="card-taxa"></p>
                <p id="card-place"><a id="card-locality"></a></p>
                <a id="card-specimen"><span id="collection-card-specimen"></span> →</a>
            </div>
        </div>
    </div>

    <div class="main-section-wrapper">
        <main id="main-content">
            <!-- Each figure is the way in to what it counts, so it is the link itself
                 rather than a link wrapped inside it. The localities and the countries
                 are both read off the map; the taxa open the drawer. The visitor tally
                 counts nothing you can go and look at, and stays a plain cell. -->
            <section id="stats-panel">
                <a class="stat" href="{{root_relative_prefix}}map">
                    <span class="stat-number">{{ n_localities }}</span>
                    <span class="stat-label" id="stat-localities-label"></span>
                </a>
                <button type="button" class="stat" onclick="toggleSidebar()">
                    <span class="stat-number">{{ n_taxa }}</span>
                    <span class="stat-label" id="stat-taxa-label"></span>
                </button>
                <a class="stat" href="{{root_relative_prefix}}gallery">
                    <span class="stat-number">{{ n_samples }}</span>
                    <span class="stat-label" id="stat-samples-label"></span>
                </a>
                <a class="stat" href="{{root_relative_prefix}}map">
                    <span class="stat-number">{{ n_countries }}</span>
                    <span class="stat-label" id="stat-countries-label"></span>
                </a>
                <div class="stat" id="visitor-stat">
                    <span class="stat-number" id="visitor-count">—</span>
                    <span class="stat-label" id="stat-visitors-label"></span>
                </div>
            </section>
            <script>
                // Pull the live visitor total from GoatCounter and swap it in for the dash.
                // The cell is in the layout from the first paint, so nothing reflows when
                // the request answers; the dash is what the figure honestly is until then.
                fetch('https://tsioftas.goatcounter.com/counter/TOTAL.json')
                    .then(r => r.json())
                    .then(d => {
                        if (!d || d.count == null) return;
                        document.getElementById('visitor-count').textContent = d.count;
                    })
                    .catch(() => {});
            </script>

            <section id="εισαγωγή" class="home-intro">
                <p id="εισαγωγή-παράγραφος" class="lead"></p>
            </section>

            <section id="απολιθώματα" class="home-section">
                <header class="section-head">
                    <h2 id="απολιθώματα-κεφαλίδα" class="section-heading"></h2>
                </header>
                <div class="tax-container rail">
                    {% for top_level_taxon, taxon_info in taxonomy.items() -%}
                    <a class="kingdom-card" href="{{page_prefix}}tree/{{top_level_taxon}}/{{top_level_taxon}}">
                        <picture>
                            <source srcset="{{root_relative_prefix}}images/thumbnails/webp_dir/{{taxon_info["name"]["el"].capitalize() | urlencode}}.webp 1x" type="image/webp">
                            <img src="{{root_relative_prefix}}images/thumbnails/{{taxon_info["name"]["el"].capitalize() | urlencode}}.jpg" alt="" class="tax-thumbnail-image" loading="lazy" width="1024" height="1024">
                        </picture>
                        <h3 id="{{taxon_info["name"]["el"]}}"></h3>
                    </a>
                    {% endfor -%}
                    <a class="kingdom-card" href="{{page_prefix}}unclassified">
                        <picture>
                            <source srcset="{{root_relative_prefix}}images/thumbnails/webp_dir/Αταξινόμητα.webp 1x" type="image/webp">
                            <img src="{{root_relative_prefix}}images/thumbnails/Αταξινόμητα.jpg" alt="" class="tax-thumbnail-image" loading="lazy" width="1024" height="1024">
                        </picture>
                        <h3 id="αταξινόμητα"></h3>
                    </a>
                </div>
            </section>

            <!-- The three ways into the collection that are not a taxon: by photograph,
                 by the whole classification, and by the notes kept alongside it. -->
            <section class="home-ways" aria-label="{{chrome.site_name}}">
                <a class="way-card" id="gallery-callout" href="{{root_relative_prefix}}gallery">
                    <span class="way-icon" aria-hidden="true">{% include "icon_gallery.html" %}</span>
                    <span class="way-title" id="callout-gallery-title"></span>
                    <span class="way-body" id="callout-gallery-body"></span>
                    <span class="way-cta"><span id="callout-gallery-cta"></span><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12 5.5 18.5 12 12 18.5"/></svg></span>
                </a>
                <button type="button" class="way-card" id="tree-callout" onclick="toggleSidebar()">
                    <span class="way-icon" aria-hidden="true">{% include "icon_tree.html" %}</span>
                    <span class="way-title" id="callout-tree-title"></span>
                    <span class="way-body" id="callout-tree-body"></span>
                    <span class="way-cta"><span id="callout-tree-cta"></span><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12 5.5 18.5 12 12 18.5"/></svg></span>
                </button>
                <a class="way-card" id="journal-callout" href="{{page_prefix}}journal/">
                    <span class="way-icon" aria-hidden="true">{% include "icon_journal.html" %}</span>
                    <span class="way-title" id="callout-journal-title"></span>
                    <span class="way-body" id="callout-journal-body"></span>
                    <span class="way-cta"><span id="callout-journal-cta"></span><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12 5.5 18.5 12 12 18.5"/></svg></span>
                </a>
            </section>

            {% if recently_catalogued -%}
            <section id="recently-catalogued-row" class="home-section">
                <header class="section-head">
                    <h2 id="πρόσφατες-προσθήκες-κεφαλίδα" class="section-heading"></h2>
                </header>
                <div class="gallery catalogued-grid rail">
                    {% for item in recently_catalogued -%}
                    <a class="sample-box" href="{{page_prefix}}{{item.href}}#sample-{{item.sample_id}}">
                        <span class="sample-frame">
                            <picture class="image-single">
                                <source srcset="{{root_relative_prefix}}{{item.images_dir}}/thumbs_dir/{{item.filename}}_thumb.webp 1x" type="image/webp">
                                <img loading="lazy" src="{{root_relative_prefix}}{{item.images_dir}}/thumbs_dir/{{item.filename}}_thumb.jpg" alt="">
                            </picture>
                            {% if item.alt_filename -%}
                            <picture class="image-single image-single-alt">
                                <source srcset="{{root_relative_prefix}}{{item.images_dir}}/thumbs_dir/{{item.alt_filename}}_thumb.webp 1x" type="image/webp">
                                <img loading="lazy" src="{{root_relative_prefix}}{{item.images_dir}}/thumbs_dir/{{item.alt_filename}}_thumb.jpg" alt="">
                            </picture>
                            {% endif -%}
                            {% if item.n_images > 1 -%}
                            <span class="sample-count">
                                {% include "icon_camera.html" %}{{item.n_images}}
                            </span>
                            {% endif -%}
                        </span>
                    </a>
                    {% endfor -%}
                </div>
            </section>
            {% endif -%}

            <div class="home-pair">
                <section id="random-sample-row" class="home-section">
                    <a href="" id="τυχαίο-δείγμα-σύνδεσμος" class="random-card">
                        <span class="random-frame">
                            <img src="" alt="" id="τυχαίο-δείγμα-εικόνα" loading="lazy" decoding="async">
                        </span>
                        <h2 class="random-caption"><span id="τυχαίο-δείγμα"></span><span id="τυχαίο-δείγμα-τίτλος"></span></h2>
                    </a>
                </section>

                <section id="recently-updated-row" class="home-section">
                    <header class="section-head">
                        <h2 id="πρόσφατες-ενημερώσεις-κεφαλίδα" class="section-heading"></h2>
                    </header>
                    <ul id="πρόσφατες-ενημερώσεις-λίστα" class="recent-updates-list">
                        {% for recentlyUpdatedPage in recent_updates -%}
                        <li class="recent-update-item">
                            <a href="{{page_prefix}}{{ recentlyUpdatedPage.url }}" class="recent-update-link">
                                <span class="recent-update-thumb">
                                    <picture>
                                        <source srcset="{{root_relative_prefix}}{{ recentlyUpdatedPage.thumbnail_webp }} 1x" type="image/webp">
                                        <img src="{{root_relative_prefix}}{{ recentlyUpdatedPage.thumbnail_jpg }}" alt="" loading="lazy">
                                    </picture>
                                </span>
                                <span class="recent-update-meta">
                                    <span id="{{ recentlyUpdatedPage.id }}-recent" class="recent-update-title"></span>
                                    <span id="{{ recentlyUpdatedPage.id }}-recent-description" class="recent-update-description"></span>
                                    <time class="recent-update-date" datetime="{{ recentlyUpdatedPage.lastmod }}">{{ recentlyUpdatedPage.lastmod }}</time>
                                </span>
                            </a>
                        </li>
                        {% endfor -%}
                    </ul>
                </section>
            </div>
        </main>
    </div>

    <div id="footer-container">{% include "footer.html" %}</div>

    {% include "cookie_banner.html" %}
</body>

<script
    id="language-script"
    src="{{root_relative_prefix}}scripts/language.js"
    dict="/index.json"
    keys="τίτλος,hero-title,hero-tagline,εισαγωγή-παράγραφος,απολιθώματα-κεφαλίδα,τυχαίο-δείγμα,πρόσφατες-ενημερώσεις-κεφαλίδα,{% if recently_catalogued %}πρόσφατες-προσθήκες-κεφαλίδα,{% endif %}callout-tree-title,callout-tree-body,callout-tree-cta,callout-gallery-title,callout-gallery-body,callout-gallery-cta,callout-journal-title,callout-journal-body,callout-journal-cta,stat-localities-label,stat-taxa-label,stat-samples-label,stat-countries-label,stat-visitors-label,collection-close,collection-end-title,collection-end-gallery,collection-end-map,collection-card-specimen,{% for top_level_taxon, taxon_info in taxonomy.items() %}{{taxon_info["name"]["el"]}},{% endfor %}{% for recentlyUpdatedPage in recent_updates %}{{ recentlyUpdatedPage.id }}-recent,{{ recentlyUpdatedPage.id }}-recent-description,{% endfor %}αταξινόμητα"
></script>

<script src="{{root_relative_prefix}}scripts/mosaic.js" defer></script>
<script src="{{root_relative_prefix}}scripts/collection.js" defer></script>
<script src="{{root_relative_prefix}}scripts/random-sample.js" id="random-script" defer></script>
<script src="{{root_relative_prefix}}scripts/sidebar.js"></script>
<script src="{{root_relative_prefix}}scripts/search.js"></script>
<script src="{{root_relative_prefix}}scripts/analytics.js"></script>
<script src="{{root_relative_prefix}}scripts/footer.js"></script>
<script src="{{root_relative_prefix}}scripts/share.js"></script>
<script src="{{root_relative_prefix}}scripts/header.js" id="header-script"></script>

</html>
