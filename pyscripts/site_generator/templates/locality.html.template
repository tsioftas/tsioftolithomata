{%- from "icons.html" import icon -%}
<!DOCTYPE html>
<html lang="{{page_lang}}" data-prerendered-lang="{{page_lang}}" data-default-lang="{{default_lang}}"
      data-site-root="{{root_relative_prefix or './'}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="{{meta_description}}">
    {% if meta_keywords -%}
    <meta name="keywords" content="{{meta_keywords}}">
    {% endif -%}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{name_en.capitalize()}}">
    <meta property="og:description" content="{{meta_description}}">
    <meta property="og:url" content="{{page_url}}">
    <meta property="og:image" content="{{og_image}}">
    <meta name="twitter:card" content="summary_large_image">
    <title id="τίτλος"></title>
    <link rel="icon" href="{{root_relative_prefix}}favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="{{root_relative_prefix}}style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lightgallery.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lg-zoom.min.css">
    {% include "head_lang.html" %}
</head>
<body class="locality-page">
    {% include "header.html" %}

    <main id="main" class="place">
        {#- The place as it was: the reconstruction holds one half of the screen while
            the field notes and the finds scroll past beside it. -#}
        <section class="place-visual{% if not has_hero_image %} is-plain{% endif %}" id="{{loc_id}}-hero">
            {% if has_hero_image -%}
            <picture class="place-media">
                <source srcset="{{root_relative_prefix}}images/localities/thumbnails/webp_dir/{{loc_id}}.webp 1x" type="image/webp">
                <img src="{{root_relative_prefix}}images/localities/thumbnails/{{loc_id}}.jpg" alt="{{name_en}}" fetchpriority="high" id="{{loc_id}}-περιγραφή-1-εικόνα">
            </picture>
            {%- endif %}
            <div class="place-title">
                {% if loc.age is defined -%}
                <p class="locality-kicker enter" style="--i:0"><span class="period-dot"></span>{{format_age(loc.age, page_lang)}}</p>
                {% endif -%}
                <h1 id="{{loc_id}}" class="mega enter" style="--i:1"></h1>
            </div>
        </section>

        <div class="place-notes">
            <section id="{{loc_id}}-description" class="locality-body">
                {% include "deep_time.html" %}

                {% if loc.formation is defined -%}
                {#- Field measurements, not prose: label in the data voice, value in the
                    reading face, one rule per row. -#}
                <dl class="locality-spec">
                    <div class="spec-row">
                        <dt id="age-label"></dt>
                        <dd class="locality-spec-num" id="{{loc_id}}-age">{{format_age(loc.age, page_lang)}}</dd>
                    </div>
                    <div class="spec-row">
                        <dt id="period-label"></dt>
                        <dd>{% if loc.age.prefix is defined %}<span id="{{loc.age.prefix}}"></span> {% endif %}<span id="{{loc.age.period}}"></span>{% if loc.age.period_detail is defined %} (<span id="{{loc.age.period_detail}}"></span>){% endif %}</dd>
                    </div>
                    <div class="spec-row">
                        <dt id="formation-label"></dt>
                        <dd id="{{loc_id}}-formation"></dd>
                    </div>
                    <div class="spec-row">
                        <dt id="depositional_environment-label"></dt>
                        <dd id="{{loc_id}}-depositional_environment"></dd>
                    </div>
                    <div class="spec-row">
                        <dt id="fossil_types-label"></dt>
                        <dd id="{{loc_id}}-fossil_types"></dd>
                    </div>
                    <div class="spec-row">
                        <dt id="paleoecology_highlights-label"></dt>
                        <dd id="{{loc_id}}-paleoecology_highlights"></dd>
                    </div>
                </dl>
                {% endif -%}

                <div class="locality-prose">
                    <div class="description-text">
                        {% for i in range(description_paragraphs) %}<p id="{{loc_id}}-περιγραφή-{{i+1}}"></p>
                        {% endfor %}
                    </div>
                    {% if loc_id == "chapel-st-leonards" %}
                    <figure class="locality-diagram">
                        <picture>
                            <source srcset="{{root_relative_prefix}}images/localities/webp_dir/longshore-drift.webp 1x" type="image/webp">
                            <img loading="lazy" src="{{root_relative_prefix}}images/localities/longshore-drift.jpg" alt="how longshore drift transported fossils at Chapel St Leonards" id="longshore-drift-εικόνα">
                        </picture>
                        <figcaption id="longshore-drift-description"></figcaption>
                    </figure>
                    {% endif %}
                </div>

                {% if loc.formation is defined -%}
                <a class="locality-globe" href="{{root_relative_prefix}}map?locality={{loc_id}}" title="{{name_en}} on the map">
                    <picture>
                        <source srcset="{{root_relative_prefix}}images/localities/globe/webp_dir/{{loc_id}}.webp 1x" type="image/webp">
                        <img loading="lazy" src="{{root_relative_prefix}}images/localities/globe/{{loc_id}}.jpg" alt="{{name_en}} shown on the globe" id="{{loc_id}}-γη-εικόνα">
                    </picture>
                    <span class="locality-globe-label">
                        {{ icon("map") }}<span>{{chrome.map}}</span>
                        {{ icon("arrow-up-right", "icon locality-globe-arrow") }}
                    </span>
                </a>
                {% endif -%}
            </section>

            {% set galleryns=namespace(img_counter=0, gallery_counter=0) -%}
            <section class="taxon-fossils place-finds" id="{{loc_id}}-galleries">
            {% for taxon_id, taxon_info in locality_taxonomy_info -%}
            {% if taxon_id in samples_by_taxon -%}
                <div class="locality-block"{% if page_period_color %} style="--loc: {{page_period_color}}"{% endif %}>
                    <header class="group-head">
                        <picture class="group-art">
                            <source srcset="{{root_relative_prefix}}images/thumbnails/thumbs_dir/{{taxon_info['name']['el'].capitalize() | urlencode}}_thumb.webp 1x" type="image/webp">
                            <img loading="lazy" src="{{root_relative_prefix}}images/thumbnails/thumbs_dir/{{taxon_info['name']['el'].capitalize() | urlencode}}_thumb.jpg" alt="">
                        </picture>
                        <div class="group-title">
                            <a class="locality-name-link" href="{{page_prefix}}{{doc_url(taxon_info['path'])}}"><h2 class="locality-name" id="{{loc_id}}-{{taxon_id}}"></h2></a>
                        </div>
                        <span class="locality-count">{{samples_by_taxon[taxon_id]|length}} {{chrome.count_specimen if samples_by_taxon[taxon_id]|length == 1 else chrome.count_specimens}}</span>
                    </header>
                    <div class="gallery" id="gallery-{{taxon_id}}">
                        {% for sample in samples_by_taxon[taxon_id] %}
                        {% set galleryns.gallery_counter = galleryns.gallery_counter + 1 %}
                        {# Only the photographs that caught this section's fossil. #}
                        {% set preview_images = images_showing(sample.preview_images, [taxon_id]) %}
                        <div class="sample-box" id="sample-{{ sample.sample_id }}" onclick="openGallery({{ galleryns.gallery_counter }})" style="--n:{{ loop.index0 }}">
                            {% include "specimen_plate.html" %}

                            {% if sample.acquisition == 'purchased' %}
                            {% set purchased = ui_string('acquisition-purchased', page_lang) %}
                            <span class="purchased-badge">
                                <svg class="purchased-badge-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12 12 2h8v8L10 20z"/><circle cx="16.5" cy="7.5" r="1.5"/></svg>
                                <span class="purchased-badge-label">{{ purchased }}</span>
                            </span>
                            {% endif %}

                            <!-- Hidden gallery -->
                            <div id="hidden-gallery-{{ galleryns.gallery_counter }}" data-sample-id="{{ sample.sample_id }}" style="display: none;">
                                {% for img in images_showing(sample.display_images, [taxon_id]) %}
                                {% set galleryns.img_counter = galleryns.img_counter + 1 %}
                                <a href="{{root_relative_prefix}}{{img.images_dir}}/{{img.filename}}.jpg" id="gallery-img-{{galleryns.img_counter}}" data-sub-html="{{ lightbox_caption(img, sample, page_lang, galleryns.gallery_counter, taxon_info) }}">
                                    <picture>
                                        <source srcset="{{root_relative_prefix}}{{img.images_dir}}/thumbs_dir/{{img.filename}}_thumb.webp 1x" type="image/webp">
                                        <img loading="lazy" src="{{root_relative_prefix}}{{img.images_dir}}/thumbs_dir/{{img.filename}}_thumb.jpg" alt="{{img.caption.en}}">
                                    </picture>
                                </a>
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif -%}
            {% endfor -%}
            </section>

            <div id="footer-container">{% include "footer.html" %}</div>
        </div>
    </main>

    <script
        id="language-script"
        src="{{root_relative_prefix}}scripts/language.js"
        {# Nothing to fetch: the strings are prefilled and the captions are in
           data-sub-html. The .json is still written, for the cyp audio pipeline. #}
        dict=""
        keys="τίτλος,{{loc_id}}{% if age_span %},deep-time-caption,deep-time-today{% endif %}{% for i in range(description_paragraphs) %},{{loc_id}}-περιγραφή-{{i+1}}{% endfor %},age-label,period-label,formation-label,depositional_environment-label,fossil_types-label,paleoecology_highlights-label,{{loc_id}}-formation,{{loc_id}}-depositional_environment,{{loc_id}}-fossil_types,{{loc_id}}-paleoecology_highlights,{% if loc.age.prefix is defined %}{{loc.age.prefix}},{% endif %}{{loc.age.period}},{% if loc.age.period_detail is defined %}{{loc.age.period_detail}},{% endif %}{% for taxon_id in samples_by_taxon.keys() -%}{{loc_id}}-{{taxon_id}},{% endfor %}{% if loc_id == "chapel-st-leonards" %}longshore-drift-description,{% endif %}mya"
    ></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/lightgallery.min.js" integrity="sha384-MjUNxSaHL/6eoaiJXs3NcsYt5PMcFos3RjoGKaBj8wqEu0lYAn0HISvhdiF8fjec" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/plugins/zoom/lg-zoom.min.js" integrity="sha384-iqgECBkmcDeuB5f3eHKQ6uwRVFs6/4auvPpRhMS/KjpIuzgmo2W17KoMh8iGyAHy" crossorigin="anonymous"></script>
    <script src="{{root_relative_prefix}}scripts/back-close.js"></script>
    <script>
        function openGallery(index, imgIndex) {
            const elem = document.getElementById("hidden-gallery-" + index);
            // Build the lightGallery instance once per specimen and reuse it on
            // subsequent opens, so closed lightboxes don't pile up in the DOM.
            if (!elem._lgInstance) {
                const items = Array.from(elem.querySelectorAll('a')).map(a => ({
                    src: a.href,
                    thumb: a.querySelector('img')?.src,
                    subHtml: a.getAttribute('data-sub-html') || '@@@@'
                }));
                elem._lgInstance = lightGallery(elem, {
                    dynamic: true,
                    plugins: [lgZoom],
                    thumbnail: true,
                    loop: true,
                    dynamicEl: items
                });
                closeLightGalleryOnBack(elem, elem._lgInstance);
                attachLightboxShare(elem, elem.dataset.sampleId);
            }
            elem._lgInstance.openGallery(imgIndex || 0);
        }
    </script>

    <script src="{{root_relative_prefix}}scripts/sidebar.js"></script>
    <script src="{{root_relative_prefix}}scripts/search.js"></script>
    <script src="{{root_relative_prefix}}scripts/analytics.js"></script>
    <script src="{{root_relative_prefix}}scripts/footer.js"></script>
    <script src="{{root_relative_prefix}}scripts/share.js"></script>
    <script src="{{root_relative_prefix}}scripts/tts.js"></script>
    <script src="{{root_relative_prefix}}scripts/header.js" id="header-script"></script>
    <script src="{{root_relative_prefix}}scripts/ui.js"></script>

    {% include "cookie_banner.html" %}
</body>
</html>
